NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Opção 1: informe uma URL completa
# DATABASE_URL=postgresql://postgres:sua_senha@127.0.0.1:5432/cafe_com_sardinha

# Opção 2: informe os campos separadamente
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=db_cafe_com_sardinha
PGUSER=postgres
PGPASSWORD=

# Use "true" somente se o seu servidor exigir SSL.
PGSSL=false

# Em produção, informe os endereços permitidos separados por vírgula.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Gere uma chave longa e aleatória em produção.
AUTH_SECRET=

# Use uma chave aleatória com pelo menos 32 caracteres; não reutilize o Client ID do Google.
# OAuth 2.0 Client ID do tipo Aplicativo da Web no Google Cloud Console.
# Formato esperado: 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=
