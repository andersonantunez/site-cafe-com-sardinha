NODE_ENV=development
PORT=3001
HOST=127.0.0.1

# Opção 1: informe uma URL completa
# DATABASE_URL=postgresql://postgres:sua_senha@127.0.0.1:5432/cafe_com_sardinha

# Opção 2: informe os campos separadamente
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=db_cafe_com_sardinha
PGUSER=postgres
PGPASSWORD=

# Use "true" somente se o seu servidor exigir SSL.
PGSSL=false

# Em produção, informe os endereços permitidos separados por vírgula.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Gere uma chave longa e aleatória em produção.
AUTH_SECRET=

# Use uma chave aleatória com pelo menos 32 caracteres; não reutilize o Client ID do Google.
# OAuth 2.0 Client ID do tipo Aplicativo da Web no Google Cloud Console.
# Formato esperado: 1234567890-abc123.apps.googleusercontent.com
GOOGLE_CLIENT_ID=

# URL pública do frontend. As URLs de retorno do checkout são derivadas daqui.
APP_URL=http://localhost:5173

# Quantidade de proxies reversos confiáveis até o Express. Mantenha false em acesso direto.
# Em uma infraestrutura com exatamente um proxy confiável, use 1.
TRUST_PROXY=false

# Gmail SMTP. Use exclusivamente uma senha de aplicativo do Google.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=cafecomsardinha@gmail.com
SMTP_PASSWORD=

# Cloudflare Turnstile (widget Managed).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Asaas Checkout hospedado. A API URL é opcional e derivada de ASAAS_ENV.
ASAAS_ENV=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token de 32 a 255 caracteres configurado no webhook; não reutilize a API key.
ASAAS_WEBHOOK_TOKEN=
ASAAS_USER_AGENT=CafeComSardinha/1.0
